<mxCell id="ST-03-T1" value="create(trip, seats)&lt;br&gt;/ status = SELECTING" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ST-03-I" target="ST-03-S1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ST-03-T2" value="holdSeats(seatFare, now) [mọi chỗ AVAILABLE]&lt;br&gt;/ chỗ HELD; holdStartedAt = now; holdExpiry = now + 10 phút; seatFare" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ST-03-S1" target="ST-03-S2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ST-03-T3" value="recordTravelerInfo(name, phone, now) [now &amp;lt; holdExpiry và đã có họ tên, số điện thoại]&lt;br&gt;/ travelerName, travelerPhone" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;exitX=0.0667;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.2667;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ST-03-S2" target="ST-03-S2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="40"/><mxPoint x="740" y="40"/></Array></mxGeometry></mxCell>
<mxCell id="ST-03-T4" value="clearHoldExpiry&lt;br&gt;/ holdExpiry = rỗng" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;exitX=0.7333;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.9333;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ST-03-S2" target="ST-03-S2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="40"/><mxPoint x="940" y="40"/></Array></mxGeometry></mxCell>
<mxCell id="ST-03-T5" value="issueTickets(codes, transaction) [số mã vé = số chỗ]&lt;br&gt;/ tạo Ticket; chỗ SOLD; holdExpiry = rỗng" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.6667;entryDx=0;entryDy=0;" edge="1" parent="1" source="ST-03-S2" target="ST-03-S3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ST-03-T6" value="releaseHeldSeats&lt;br&gt;/ chỗ AVAILABLE; holdExpiry = rỗng" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;exitX=0.1333;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1333;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ST-03-S2" target="ST-03-S4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ST-03-T7" value="when(now &amp;gt;= holdExpiry) [holdExpiry có giá trị]&lt;br&gt;/ releaseHeldSeats (qua DC-BookTicketOnlineService.handleHoldExpiry)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;exitX=0.8000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ST-03-S2" target="ST-03-S4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
