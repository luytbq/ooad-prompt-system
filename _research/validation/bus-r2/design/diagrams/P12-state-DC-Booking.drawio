<mxCell id="ST-03-S2" value="&lt;b&gt;Holding&lt;/b&gt;&lt;br&gt;do / chờ tới holdExpiry (bộ định thời PKG-11 quét)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="300" height="100" as="geometry"/></mxCell>
